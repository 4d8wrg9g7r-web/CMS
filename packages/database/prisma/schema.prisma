// CMS — church operating platform schema (see docs/architecture/BLUEPRINT.md).
// Fresh baseline at the Ruach separation: every tenant-owned model carries
// organizationId (tenant guard enforced), Campus is a first-class primitive (§4), and
// the platform modules compose Person/Household/Group/Form/Event/Task/Message/Workflow/
// File exactly as the Constitution requires.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships         OrganizationMember[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  createdTasks        Task[]               @relation("TaskCreatedBy")
  journeyEnrollments  JourneyEnrollment[]  @relation("EnrollmentEnrolledBy")
  milestoneCompletions JourneyMilestoneCompletion[] @relation("CompletionCompletedBy")
  personImports       PersonImport[]       @relation("PersonImportCreatedBy")
  contributionBatches ContributionBatch[]  @relation("ContributionBatchCreatedBy")
  contributions       Contribution[]       @relation("ContributionCreatedBy")
  savedReports        SavedReport[]        @relation("SavedReportCreatedBy")
  emailBlasts         EmailBlast[]         @relation("EmailBlastCreatedBy")
  savedPersonFilters  SavedPersonFilter[]  @relation("SavedPersonFilterCreatedBy")
  dashboardPreferences DashboardPreference[] @relation("DashboardPreferenceUser")
  groupPosts           GroupPost[]           @relation("GroupPostAuthorUser")
}

/** Single-use, short-lived; a fresh request invalidates prior unused tokens. */
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  CONTENT_MANAGER
  ANALYTICS_VIEWER
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  // Public URL key for org-level public surfaces: /c/<id> (events calendar) and
  // /g/<id> (group finder). Same bootstrapping boundary as forms/events publicIds.
  publicSiteId String   @unique @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members  OrganizationMember[]
  campuses Campus[]

  auditLogs AuditLog[]

  people              Person[]
  households          Household[]
  personRelationships PersonRelationship[]
  personFieldDefinitions PersonFieldDefinition[]
  personFieldValues      PersonFieldValue[]
  funds                  Fund[]
  contributionBatches    ContributionBatch[]
  contributions          Contribution[]
  savedReports           SavedReport[]
  emailBlasts            EmailBlast[]
  emailBlastAttachments  EmailBlastAttachment[]
  savedPersonFilters     SavedPersonFilter[]
  dashboardPreferences   DashboardPreference[]
  sermons                Sermon[]
  sermonDocuments SermonDocument[]
  mediaAssets            MediaAsset[]
  livestreamChatMessages LivestreamChatMessage[]
  livestreamChatRoles    LivestreamChatRole[]
  churchApp              ChurchApp?
  appPosts               AppPost[]
  appPostLikes           AppPostLike[]
  appPostComments        AppPostComment[]
  appSessions            AppSession[]
  appLoginCodes          AppLoginCode[]
  appPushSubscriptions   AppPushSubscription[]
  appPages               AppPage[]
  groupPosts             GroupPost[]
  groupPostPrayers       GroupPostPrayer[]
  groupEvents            GroupEvent[]
  groupEventRsvps        GroupEventRsvp[]
  groupPolls             GroupPoll[]
  groupPollVotes         GroupPollVote[]
  groups              Group[]
  groupMemberships    GroupMembership[]
  forms               FormDefinition[]
  formVersions        FormVersion[]
  formSubmissions     FormSubmission[]
  outboxEvents        OutboxEvent[]
  processedEvents     ProcessedEvent[]
  workflows           WorkflowDefinition[]
  workflowVersions    WorkflowVersion[]
  workflowRuns        WorkflowRun[]
  tasks               Task[]
  journeys            JourneyDefinition[]
  journeyMilestones   JourneyMilestone[]
  journeyEnrollments  JourneyEnrollment[]
  journeyMilestoneCompletions JourneyMilestoneCompletion[]
  events              Event[]
  eventCalendars EventCalendar[]
  eventRegistrations  EventRegistration[]
  messages            Message[]
  checkIns            CheckIn[]
  servingTeams        ServingTeam[]
  servingPositions    ServingPosition[]
  servingAssignments  ServingAssignment[]
  personQualifications PersonQualification[]
  files               File[]
  apiKeys             ApiKey[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries   WebhookDelivery[]
  personImports       PersonImport[]
  onlineGivingConfig  OnlineGivingConfig?
  recurringGifts      RecurringGift[]
  campaigns           Campaign[]
  pledges             Pledge[]
  site                Site?
  sitePages           SitePage[]
  inboxDismissals     InboxDismissal[]
}

/**
 * Per-church Stripe configuration for online giving (docs/domain/giving.md
 * "Online giving", ADR-015). The church connects its OWN Stripe account by
 * pasting its secret key + webhook signing secret — money settles directly to
 * the church, the platform never touches funds. Keys are write-only in the UI
 * (masked on read) and must never appear in any app-facing payload.
 */
model OnlineGivingConfig {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  enabled             Boolean  @default(false)
  stripeSecretKey     String?
  stripeWebhookSecret String?
  currency            String   @default("usd")
  // Offer bank (ACH) giving — opt-in; the church must enable ACH debits on
  // its Stripe account first or Checkout will reject the session.
  achEnabled          Boolean  @default(false)
  // Text-to-give: the church points a Twilio number's inbound-SMS webhook at
  // /api/giving/text/<publicAppId>; the auth token verifies Twilio's
  // signature (write-only in the UI, like the Stripe keys).
  textGivingEnabled   Boolean  @default(false)
  twilioAuthToken     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * The church's public website (docs/domain/website.md): a section-based site
 * built in the dashboard's Website studio and served at /w/<publicSiteKey>.
 * One Site per org; theme + contact + service times live in `config`
 * (validated by src/site/site-config.ts). Pages hold ordered section blocks.
 */
model Site {
  id             String   @id @default(cuid())
  organizationId String   @unique
  /** Public URL key — /w/<publicSiteKey>; unguessable, like publicAppId. */
  publicSiteKey  String   @unique @default(cuid())
  published      Boolean  @default(false)
  config         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pages        SitePage[]
}

model SitePage {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String
  /** URL segment; "home" is the root page. */
  slug           String
  title          String
  /** Ordered section blocks (validated by src/site/site-sections.ts). */
  sections       Json
  /** Show in the site's nav (home is always the logo link). */
  inNav          Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([organizationId])
}

/**
 * A pledge campaign (docs/domain/giving.md "Pledge campaigns"): a fundraising
 * push toward a goal, tied to a Fund and a time window. Progress = ALL
 * contributions to that fund inside the window — checks counted on Sunday and
 * online gifts alike — so the thermometer reflects the real ledger.
 */
model Campaign {
  id             String    @id @default(cuid())
  organizationId String
  fundId         String
  name           String
  description    String?
  goalCents      Int
  startsAt       DateTime
  endsAt         DateTime?
  /** Show a progress card (and pledge form) on the church app's Give tab. */
  showInApp      Boolean   @default(true)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fund         Fund         @relation(fields: [fundId], references: [id])
  pledges      Pledge[]

  @@index([organizationId])
}

/** One pledge per person per campaign; fulfillment = their gifts to the campaign's fund in-window. */
model Pledge {
  id             String   @id @default(cuid())
  organizationId String
  campaignId     String
  personId       String
  amountCents    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([campaignId, personId])
  @@index([organizationId])
}

/**
 * A resolved item in the operational Inbox (docs/design-system.md "Inbox").
 * Inbox items are DERIVED from existing tables (form submissions, failed
 * automations, registrations, prayer requests...) — this table only records
 * which item keys staff have resolved, org-wide, so the feed stays quiet.
 */
model InboxDismissal {
  id             String   @id @default(cuid())
  organizationId String
  /** Stable derived key, e.g. "submission:<id>", "run:<id>". */
  itemKey        String
  dismissedByUserId String?
  dismissedAt    DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, itemKey])
}

/**
 * A donor's recurring gift schedule, mirrored from Stripe subscriptions so the
 * app can show and cancel it without keys ever reaching a client. Upserted by
 * the giving webhook on invoice.paid; marked canceled locally on cancel and by
 * customer.subscription.deleted.
 */
model RecurringGift {
  id             String    @id @default(cuid())
  organizationId String
  subscriptionId String
  personId       String?
  email          String?
  fundId         String?
  amountCents    Int
  /** "week" | "2week" | "month" — display only; Stripe owns the schedule. */
  interval       String
  canceledAt     DateTime?
  lastPaymentAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  fund         Fund?        @relation(fields: [fundId], references: [id], onDelete: SetNull)

  @@unique([organizationId, subscriptionId])
  @@index([organizationId, personId])
}

/**
 * userId is @unique -- one organization per user account in v1 (no multi-org
 * switching); see lib/session.ts's getCurrentOrganization.
 */
model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String           @unique
  role           OrganizationRole
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/**
 * The Campus primitive (BLUEPRINT §4): a physical/digital ministry location. First-class
 * here (unlike the pre-separation codebase, which reused a Website model) -- resolves the
 * "Campus modeling" risk recorded in the original domain specs. People, Groups, Events,
 * and Serving Teams optionally scope to one campus; null = org-wide.
 */
model Campus {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  address        String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  people       Person[]
  groups       Group[]
  events       Event[]
  servingTeams ServingTeam[]

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  targetType     String
  targetId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// People & Households (BLUEPRINT §5 -- the canonical Person primitive)
// ---------------------------------------------------------------------------

enum MembershipStatus {
  VISITOR
  ATTENDER
  MEMBER
  INACTIVE
}

enum HouseholdRole {
  ADULT
  CHILD
  OTHER
  HEAD_OF_HOUSEHOLD
  FATHER
  MOTHER
  GRANDPARENT
}

enum PersonRelationshipType {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  GRANDPARENT
  GRANDCHILD
  FOSTER_PARENT
  FOSTER_CHILD
  GUARDIAN
  WARD
  OTHER
}

enum PersonFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

/**
 * Org-defined custom person fields (docs/domain/people.md "Custom fields"): unlimited
 * per organization, keyed by a stable slug so imports reuse them across runs.
 * Definitions are archived, never deleted, so historical values stay interpretable.
 */
model PersonFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  key            String
  label          String
  type           PersonFieldType
  // Valid choices for SELECT/MULTI_SELECT; empty for other types. Imports may append.
  options        String[]        @default([])
  archivedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  values       PersonFieldValue[]

  @@unique([organizationId, key])
  @@index([organizationId])
}

model PersonFieldValue {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  fieldId        String
  // Shape depends on the definition's type: string | number | boolean | string[].
  value          Json
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  field        PersonFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([personId, fieldId])
  @@index([organizationId])
  @@index([fieldId])
}

model Household {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  region         String?
  postalCode     String?
  country        String?
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      Person[]

  @@index([organizationId])
}

model Person {
  id             String  @id @default(cuid())
  organizationId String
  householdId    String?
  householdRole  HouseholdRole?
  // Home campus (null = org-wide).
  campusId       String?

  firstName     String
  middleName    String?
  lastName      String
  suffix        String?
  preferredName String?
  gender        String?
  email         String?
  phone         String?
  // Member-facing avatar (public storage URL) — uploadable from the church app.
  photoUrl      String?

  membershipStatus MembershipStatus @default(VISITOR)
  birthdate        DateTime?
  tags             String[]         @default([])
  notes            String?
  // Email consent (BLUEPRINT §19): set = person-linked sends are suppressed by
  // message-service.queueMessage; changes audited.
  emailOptedOutAt DateTime?

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  household         Household?           @relation(fields: [householdId], references: [id], onDelete: SetNull)
  campus            Campus?              @relation(fields: [campusId], references: [id], onDelete: SetNull)
  relationshipsFrom PersonRelationship[] @relation("PersonRelationshipFrom")
  relationshipsTo   PersonRelationship[] @relation("PersonRelationshipTo")
  groupMemberships  GroupMembership[]
  formSubmissions   FormSubmission[]
  workflowRuns      WorkflowRun[]
  tasks             Task[]
  journeyEnrollments JourneyEnrollment[]
  eventRegistrations EventRegistration[]
  messages          Message[]
  checkIns          CheckIn[]
  livestreamChatMessages LivestreamChatMessage[]
  livestreamChatRoles    LivestreamChatRole[]
  servingAssignments ServingAssignment[]
  qualifications    PersonQualification[]
  files             File[]
  fieldValues       PersonFieldValue[]
  contributions     Contribution[]
  recurringGifts    RecurringGift[]
  pledges           Pledge[]
  appPosts          AppPost[]
  appPostLikes      AppPostLike[]
  appPostComments   AppPostComment[]
  appSessions       AppSession[]
  appLoginCodes     AppLoginCode[]
  appPushSubscriptions AppPushSubscription[]
  groupPosts        GroupPost[]
  groupPostPrayers  GroupPostPrayer[]
  groupEventRsvps   GroupEventRsvp[]
  groupPollVotes    GroupPollVote[]

  @@index([organizationId])
  @@index([organizationId, lastName])
  @@index([householdId])
  @@index([campusId])
}

model PersonRelationship {
  id              String                 @id @default(cuid())
  organizationId  String
  personId        String
  relatedPersonId String
  type            PersonRelationshipType
  createdAt       DateTime               @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person        Person       @relation("PersonRelationshipFrom", fields: [personId], references: [id], onDelete: Cascade)
  relatedPerson Person       @relation("PersonRelationshipTo", fields: [relatedPersonId], references: [id], onDelete: Cascade)

  @@unique([personId, relatedPersonId, type])
  @@index([organizationId])
  @@index([personId])
  @@index([relatedPersonId])
}

/**
 * Summary record of one CSV people-import run (docs/domain/people-import.md). The raw
 * file is parsed in-request and never stored (PII-preserving default); only counts and
 * a capped per-line error list persist. Imports deliberately do NOT fire PersonCreated
 * workflow triggers — see the service.
 */
model PersonImport {
  id              String   @id @default(cuid())
  organizationId  String
  fileName        String?
  totalRows       Int
  createdCount    Int
  skippedCount    Int
  errorCount      Int
  /** Array of {line, message}, capped at 100 entries. */
  errors          Json     @default("[]")
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("PersonImportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Giving — contribution RECORDING only (docs/domain/giving.md). Online card/ACH
// processing is deliberately absent pending the tokenized-processor integration
// (ADR-006): no card numbers, bank accounts, or processor tokens live here.
// Amounts are integer cents — never floats.
// ---------------------------------------------------------------------------

enum ContributionMethod {
  CASH
  CHECK
  CARD
  ACH
  ONLINE
  OTHER
}

enum BatchStatus {
  OPEN
  CLOSED
}

model Fund {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  // False for payments for goods/services (books, trip fees, event payments) —
  // recorded identically but excluded from tax statements.
  taxDeductible  Boolean   @default(true)
  // Shown as a giving option in the church app when online giving is enabled.
  onlineEnabled  Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contributions Contribution[]
  recurringGifts RecurringGift[]
  campaigns     Campaign[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/** A counting session (Sunday offering, scanner run) reconciled before closing. */
model ContributionBatch {
  id              String      @id @default(cuid())
  organizationId  String
  name            String
  batchDate       DateTime
  status          BatchStatus @default(OPEN)
  // The counted total, in cents, to reconcile the entered rows against.
  expectedCents   Int?
  closedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("ContributionBatchCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  contributions Contribution[]

  @@index([organizationId, batchDate])
}

model Contribution {
  id              String             @id @default(cuid())
  organizationId  String
  // Null = donor not linked to a Person (anonymous cash, unmatched scanner row).
  personId        String?
  // Donor name captured when no Person matched, so the record stays attributable.
  donorName       String?
  fundId          String
  batchId         String?
  amountCents     Int
  method          ContributionMethod
  checkNumber     String?
  receivedAt      DateTime
  note            String?
  createdByUserId String?
  // Payment-processor id (Stripe payment_intent / invoice) — idempotency key
  // for webhook-recorded gifts; null for manually entered rows.
  externalId      String?
  createdAt       DateTime           @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  fund         Fund               @relation(fields: [fundId], references: [id])
  batch        ContributionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy    User?              @relation("ContributionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, externalId])
  @@index([organizationId, receivedAt])
  @@index([personId])
  @@index([fundId])
  @@index([batchId])
}

/**
 * A saved report-builder configuration (docs/domain/reports.md). `config` is an
 * untrusted ReportConfig JSON — re-validated by validateReportConfig on every run,
 * never executed as stored.
 */
model SavedReport {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  config          Json
  // Pinned reports render live on the dashboard Overview.
  pinned          Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("SavedReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

/**
 * A saved People-list filter combination ("smart filter"): name + the list's query
 * config, re-run live wherever it's shown. Pinned filters surface on the dashboard
 * Overview with a live count.
 */
model SavedPersonFilter {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  config          Json
  pinned          Boolean  @default(false)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("SavedPersonFilterCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

/**
 * Per-user dashboard Overview layout (docs/domain/reports.md): pinned-report
 * order, hidden sections. Personal preference, one row per member per org —
 * it never grants or hides data access, only arranges what the viewer's
 * permissions already allow.
 */
/**
 * Sermon library (docs/domain/app.md): the media content behind the church app's
 * Sermons tab. v1 is metadata + an external video/audio URL (YouTube, Vimeo,
 * podcast host) — CMS hosts no media bytes. Soft archival, ministry history kept.
 */
model Sermon {
  id             String    @id @default(cuid())
  organizationId String
  /// Public URL key — /s/<publicId> share/embed page; unguessable, like publicSiteKey.
  publicId       String    @unique @default(cuid())
  title          String
  speaker        String?
  series         String?
  passage        String?
  description    String?
  videoUrl       String?
  /// Direct audio file (public storage) for audio-only listeners.
  audioUrl       String?
  /// Sermon graphic from the media library (public storage).
  artworkUrl     String?
  /// Custom links [{label,url}] — validated in the service, max 10, http(s) only.
  links          Json      @default("[]")
  preachedAt     DateTime
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents    SermonDocument[]

  @@index([organizationId, preachedAt])
}

/// Documents attached to a sermon (notes, discussion guides) — public storage.
model SermonDocument {
  id             String   @id @default(cuid())
  organizationId String
  sermonId       String
  name           String
  url            String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sermon       Sermon       @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sermonId])
}

enum LivestreamChatRoleKind {
  HOST
  MODERATOR
}

/// Livestream chat (docs/domain/app.md): messages during services. Members
/// post from the app's livestream tab; staff can post from the dashboard
/// (personId null, displayName carries the name). Hidden = moderated out.
model LivestreamChatMessage {
  id             String    @id @default(cuid())
  organizationId String
  personId       String?
  displayName    String
  body           String
  hiddenAt       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

/// Assignable chat roles: HOST (badge + moderation) and MODERATOR (moderation).
model LivestreamChatRole {
  id             String                 @id @default(cuid())
  organizationId String
  personId       String
  role           LivestreamChatRoleKind
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personId])
}

/// Media library graphics (public storage), organized into collections —
/// "event" and "sermon" — and attached to items via Event.imageUrl /
/// Sermon.artworkUrl.
model MediaAsset {
  id             String   @id @default(cuid())
  organizationId String
  collection     String
  name           String
  url            String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, collection, createdAt])
}

/**
 * The church's mobile app (docs/domain/app.md): one per organization. `config` is
 * the validated app manifest (branding, tabs); `publicAppId` keys the public
 * /a/<id> surface, live only while `enabled`. Same bootstrapping boundary as
 * forms/events publicIds.
 */
model ChurchApp {
  id             String   @id @default(cuid())
  organizationId String   @unique
  publicAppId    String   @unique @default(cuid())
  enabled        Boolean  @default(false)
  // Discoverable in the container app's "find your church" directory. Direct
  // links and QR codes keep working when false — this only affects search.
  listedInDirectory Boolean @default(true)
  // Livestream chat slow mode: members without a chat role wait this many
  // seconds between messages (0 = off).
  chatSlowModeSeconds Int @default(0)
  config         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Church app community feed (docs/domain/app.md)
// ---------------------------------------------------------------------------

enum AppPostKind {
  CHURCH
  MEMBER
}

/**
 * A post on the app's home feed. CHURCH posts are staff announcements (no
 * author Person required); MEMBER posts are authored by a signed-in member.
 * groupId scopes visibility to that group's members; null = church-wide.
 * hiddenAt is staff moderation — hidden posts vanish from the feed but are
 * kept for accountability.
 */
model AppPost {
  id             String      @id @default(cuid())
  organizationId String
  kind           AppPostKind
  personId       String?
  groupId        String?
  body           String
  // Optional photo (public storage URL) — a post needs text or a photo.
  imageUrl       String?
  hiddenAt       DateTime?
  createdAt      DateTime    @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person?          @relation(fields: [personId], references: [id], onDelete: Cascade)
  group        Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  likes        AppPostLike[]
  comments     AppPostComment[]

  @@index([organizationId, createdAt])
  @@index([groupId])
}

model AppPostLike {
  id             String   @id @default(cuid())
  organizationId String
  postId         String
  personId       String
  // One reaction per person per post, changeable; whitelist enforced in service.
  emoji          String   @default("❤️")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         AppPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([postId, personId])
  @@index([organizationId])
}

model AppPostComment {
  id              String   @id @default(cuid())
  organizationId  String
  postId          String
  personId        String
  body            String
  // Single-level threading: replies point at a top-level comment, never a reply.
  parentCommentId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         AppPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  parent       AppPostComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies      AppPostComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([organizationId])
}

/**
 * Member sign-in for the church app: a 6-digit code emailed to a Person's
 * address (hashed at rest, short-lived, attempt-capped) exchanges for a
 * long-lived AppSession whose random token (hashed at rest) lives in an
 * httpOnly cookie. Members are People — no separate account system.
 */
model AppLoginCode {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  codeHash       String
  attempts       Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
}

/**
 * A custom app page (docs/domain/app.md): church-designed screen made of
 * validated blocks (graphics with links, headings, text, buttons). Referenced
 * by `page` tabs in the app manifest; soft-archived, never deleted.
 */
model AppPage {
  id             String    @id @default(cuid())
  organizationId String
  title          String
  blocks         Json
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/**
 * Push subscription for a signed-in member's device (docs/domain/app.md).
 * kind "webpush": endpoint is the browser push URL with p256dh/auth keys
 * (pruned on 404/410). kind "expo": endpoint is the Expo push token from the
 * native app (pruned on DeviceNotRegistered). endpoint stays globally unique.
 */
model AppPushSubscription {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  kind           String   @default("webpush")
  endpoint       String   @unique
  p256dh         String?
  auth           String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
}

model AppSession {
  id             String   @id @default(cuid())
  organizationId String
  personId       String
  tokenHash      String   @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([organizationId, personId])
}

model DashboardPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  config         Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("DashboardPreferenceUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ---------------------------------------------------------------------------
// Groups (BLUEPRINT §8)
// ---------------------------------------------------------------------------

enum GroupType {
  SMALL_GROUP
  CLASS
  MINISTRY_TEAM
  SERVING_TEAM
  OTHER
}

enum GroupEnrollment {
  OPEN
  REQUEST
  INVITE_ONLY
  CLOSED
}

enum GroupMembershipRole {
  LEADER
  CO_LEADER
  MEMBER
}

model Group {
  id              String          @id @default(cuid())
  organizationId  String
  name            String
  type            GroupType       @default(SMALL_GROUP)
  description     String?
  enrollment      GroupEnrollment @default(OPEN)
  meetingSchedule String?
  meetingLocation String?
  capacity        Int?
  isPublished     Boolean         @default(false)
  campusId        String?
  archivedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?           @relation(fields: [campusId], references: [id], onDelete: SetNull)
  memberships  GroupMembership[]
  appPosts     AppPost[]
  groupPosts   GroupPost[]
  groupEvents  GroupEvent[]
  groupPolls   GroupPoll[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@index([campusId])
}

model GroupMembership {
  id             String              @id @default(cuid())
  organizationId String
  groupId        String
  personId       String
  role           GroupMembershipRole @default(MEMBER)
  joinedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([groupId, personId])
  @@index([organizationId])
  @@index([groupId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Group space (docs/domain/groups.md): chat, links, prayer, events, polls
// ---------------------------------------------------------------------------

enum GroupPostKind {
  MESSAGE
  LINK
  PRAYER
}

/**
 * One entry in a group's stream: chat message, shared link, or prayer request.
 * Authored by a member (personId) or by staff from the dashboard (authorUserId,
 * shown as the church). Prayer requests may be anonymous (author stored for
 * moderation, hidden in rendering). hiddenAt = leader/staff moderation.
 */
model GroupPost {
  id             String        @id @default(cuid())
  organizationId String
  groupId        String
  kind           GroupPostKind
  personId       String?
  authorUserId   String?
  body           String
  url            String?
  anonymous      Boolean       @default(false)
  hiddenAt       DateTime?
  createdAt      DateTime      @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person       Person?           @relation(fields: [personId], references: [id], onDelete: Cascade)
  authorUser   User?             @relation("GroupPostAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  prayers      GroupPostPrayer[]

  @@index([groupId, createdAt])
  @@index([organizationId])
}

/** "I'm praying" responses on PRAYER posts — one per member. */
model GroupPostPrayer {
  id             String   @id @default(cuid())
  organizationId String
  postId         String
  personId       String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  post         GroupPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([postId, personId])
  @@index([organizationId])
}

/**
 * Group-only events — deliberately separate from the church Event model.
 * RSVP + leader-marked attendance live on GroupEventRsvp.
 */
model GroupEvent {
  id             String    @id @default(cuid())
  organizationId String
  groupId        String
  title          String
  description    String?
  location       String?
  startAt        DateTime
  endAt          DateTime?
  createdByPersonId String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  rsvps        GroupEventRsvp[]

  @@index([groupId, startAt])
  @@index([organizationId])
}

enum GroupRsvpStatus {
  GOING
  MAYBE
  NO
}

/** One row per member per group event: their RSVP, and (after the event) whether a leader marked them present. */
model GroupEventRsvp {
  id             String          @id @default(cuid())
  organizationId String
  groupEventId   String
  personId       String
  status         GroupRsvpStatus @default(GOING)
  attended       Boolean?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  groupEvent   GroupEvent   @relation(fields: [groupEventId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([groupEventId, personId])
  @@index([organizationId])
}

/** A group poll ("where should we meet?"): 2-10 options, one vote per member, closeable by leaders. */
model GroupPoll {
  id             String    @id @default(cuid())
  organizationId String
  groupId        String
  question       String
  options        Json
  createdByPersonId String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  group        Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  votes        GroupPollVote[]

  @@index([groupId, createdAt])
  @@index([organizationId])
}

model GroupPollVote {
  id             String   @id @default(cuid())
  organizationId String
  pollId         String
  personId       String
  optionIndex    Int
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  poll         GroupPoll    @relation(fields: [pollId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([pollId, personId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Forms (BLUEPRINT §7 -- versioned schemas)
// ---------------------------------------------------------------------------

enum FormStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model FormDefinition {
  id             String     @id @default(cuid())
  organizationId String
  title          String
  description    String?
  publicId       String     @unique @default(cuid())
  status         FormStatus @default(DRAFT)
  draftSchema    Json       @default("[]")
  publishedVersion Int?
  confirmationMessage String @default("Thanks! Your response has been received.")
  createPeople   Boolean    @default(true)
  notificationEmails String[] @default([])
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     FormVersion[]
  submissions  FormSubmission[]

  @@index([organizationId])
}

model FormVersion {
  id             String   @id @default(cuid())
  organizationId String
  formId         String
  version        Int
  schema         Json
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, version])
  @@index([organizationId])
}

model FormSubmission {
  id             String   @id @default(cuid())
  organizationId String
  formId         String
  version        Int
  data           Json
  personId       String?
  submitterEmail String?
  submitterName  String?
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  form         FormDefinition @relation(fields: [formId], references: [id], onDelete: Cascade)
  person       Person?        @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([formId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Transactional outbox (BLUEPRINT §38)
// ---------------------------------------------------------------------------

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model OutboxEvent {
  id             String       @id @default(cuid())
  organizationId String
  type           String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  dedupeKey      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([status, nextAttemptAt])
  @@index([organizationId])
}

model ProcessedEvent {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  handler        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([eventId, handler])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Workflow engine (BLUEPRINT §39 -- versioned, runs pin their version)
// ---------------------------------------------------------------------------

enum WorkflowStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowDefinition {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  trigger        String
  triggerFormId  String?
  draftConfig    Json           @default("{}")
  publishedVersion Int?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     WorkflowVersion[]
  runs         WorkflowRun[]

  @@index([organizationId])
  @@index([organizationId, status, trigger])
}

model WorkflowVersion {
  id             String   @id @default(cuid())
  organizationId String
  workflowId     String
  version        Int
  config         Json
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([organizationId])
}

model WorkflowRun {
  id             String            @id @default(cuid())
  organizationId String
  workflowId     String
  version        Int
  status         WorkflowRunStatus @default(PENDING)
  currentStep    Int               @default(0)
  attempts       Int               @default(0)
  nextStepAt     DateTime          @default(now())
  context        Json
  log            Json              @default("[]")
  personId       String?
  triggeredByEventId String?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  person       Person?            @relation(fields: [personId], references: [id], onDelete: SetNull)
  createdTasks Task[]
  journeyEnrollments JourneyEnrollment[]
  messages     Message[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([status, nextStepAt])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Tasks (BLUEPRINT §26/§40 -- universal work primitive)
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(OPEN)
  priority       TaskPriority @default(NORMAL)
  dueAt          DateTime?
  assigneeUserId String?
  relatedPersonId String?
  workflowRunId  String?
  createdByUserId String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee      User?        @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  createdBy     User?        @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  relatedPerson Person?      @relation(fields: [relatedPersonId], references: [id], onDelete: SetNull)
  workflowRun   WorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, assigneeUserId])
  @@index([relatedPersonId])
  @@index([workflowRunId])
}

// ---------------------------------------------------------------------------
// Journeys (BLUEPRINT §6 -- living pathways)
// ---------------------------------------------------------------------------

enum JourneyEnrollmentStatus {
  ACTIVE
  COMPLETED
  EXITED
}

model JourneyDefinition {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  milestones   JourneyMilestone[]
  enrollments  JourneyEnrollment[]

  @@index([organizationId])
}

model JourneyMilestone {
  id             String  @id @default(cuid())
  organizationId String
  journeyId      String
  name           String
  description    String?
  order          Int
  targetDays     Int?
  createdAt      DateTime @default(now())

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journey      JourneyDefinition            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  completions  JourneyMilestoneCompletion[]

  @@unique([journeyId, order])
  @@index([organizationId])
  @@index([journeyId])
}

model JourneyEnrollment {
  id             String                  @id @default(cuid())
  organizationId String
  journeyId      String
  personId       String
  status         JourneyEnrollmentStatus @default(ACTIVE)
  enrolledByUserId String?
  workflowRunId  String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  exitedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  journey      JourneyDefinition @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  person       Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  enrolledBy   User?             @relation("EnrollmentEnrolledBy", fields: [enrolledByUserId], references: [id], onDelete: SetNull)
  workflowRun  WorkflowRun?      @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  completions  JourneyMilestoneCompletion[]

  @@unique([journeyId, personId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([personId])
}

model JourneyMilestoneCompletion {
  id                String   @id @default(cuid())
  organizationId    String
  enrollmentId      String
  milestoneId       String
  completedByUserId String?
  completedAt       DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollment   JourneyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  milestone    JourneyMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  completedBy  User?             @relation("CompletionCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, milestoneId])
  @@index([organizationId])
  @@index([enrollmentId])
}

// ---------------------------------------------------------------------------
// Events & Registrations (BLUEPRINT §13 -- compute-on-read recurrence)
// ---------------------------------------------------------------------------

enum EventRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
}

/// A named calendar (Youth, Worship, Main…) events file under — filterable
/// on the dashboard and the public calendar. Color is a hex chip.
model EventCalendar {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String   @default("#2566e8")
  archivedAt     DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
}

model Event {
  id             String          @id @default(cuid())
  organizationId String
  calendarId     String?
  title          String
  description    String?
  location       String?
  /// Event graphic from the media library (public storage).
  imageUrl       String?
  startAt        DateTime
  endAt          DateTime?
  allDay         Boolean         @default(false)
  recurrence     EventRecurrence @default(NONE)
  recurrenceInterval Int         @default(1)
  recurrenceUntil    DateTime?
  capacity       Int?
  isPublished    Boolean         @default(false)
  publicId       String          @unique @default(cuid())
  campusId       String?
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus        Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  calendar      EventCalendar?      @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  checkIns      CheckIn[]

  @@index([organizationId, startAt])
  @@index([organizationId])
  @@index([campusId])
  @@index([calendarId])
}

model EventRegistration {
  id             String                  @id @default(cuid())
  organizationId String
  eventId        String
  personId       String?
  name           String
  email          String?
  status         EventRegistrationStatus @default(REGISTERED)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person       Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([eventId, personId])
  @@index([organizationId])
  @@index([eventId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Communications (BLUEPRINT §19 -- Message log)
// ---------------------------------------------------------------------------

enum MessageChannel {
  EMAIL
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
}

model Message {
  id             String         @id @default(cuid())
  organizationId String
  channel        MessageChannel @default(EMAIL)
  toEmail        String
  toPersonId     String?
  subject        String
  body           String
  status         MessageStatus  @default(QUEUED)
  source         String
  workflowRunId  String?
  blastId        String?
  error          String?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toPerson     Person?      @relation(fields: [toPersonId], references: [id], onDelete: SetNull)
  workflowRun  WorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  blast        EmailBlast?  @relation(fields: [blastId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([toPersonId])
  @@index([blastId])
}

/**
 * A bulk email / newsletter (docs/domain/communications.md): one composed message
 * fanned out to an audience as individual Message rows (consent enforced per
 * recipient by queueMessage). Body is markdown, rendered to email HTML at send
 * time; attachment bytes live in private storage, metadata here.
 */
model EmailBlast {
  id              String   @id @default(cuid())
  organizationId  String
  subject         String
  bodyMarkdown    String
  // Rich block layout (image/heading/text/button/divider) — when present the email
  // renders from blocks and bodyMarkdown holds the derived plain-text alternative.
  blocks          Json?
  audience        Json
  recipientCount  Int      @default(0)
  suppressedCount Int      @default(0)
  noEmailCount    Int      @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                  @relation("EmailBlastCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attachments  EmailBlastAttachment[]
  messages     Message[]

  @@index([organizationId, createdAt])
}

model EmailBlastAttachment {
  id             String   @id @default(cuid())
  organizationId String
  blastId        String
  fileName       String
  contentType    String
  sizeBytes      Int
  storageKey     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  blast        EmailBlast   @relation(fields: [blastId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([blastId])
}

// ---------------------------------------------------------------------------
// Check-In (BLUEPRINT §12 -- adult/general attendance foundations)
// ---------------------------------------------------------------------------

model CheckIn {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String
  occurrenceAt   DateTime
  personId       String
  checkedInByUserId String?
  checkedInAt    DateTime @default(now())
  checkedOutAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, occurrenceAt, personId])
  @@index([organizationId])
  @@index([eventId, occurrenceAt])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Volunteers & Serving (BLUEPRINT §10 -- flagged eligibility, preserved history)
// ---------------------------------------------------------------------------

enum ServingAssignmentStatus {
  ACTIVE
  INACTIVE
}

model ServingTeam {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  campusId       String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campus       Campus?           @relation(fields: [campusId], references: [id], onDelete: SetNull)
  positions    ServingPosition[]

  @@index([organizationId])
}

model ServingPosition {
  id             String   @id @default(cuid())
  organizationId String
  teamId         String
  name           String
  requiredQualifications String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         ServingTeam         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignments  ServingAssignment[]

  @@index([organizationId])
  @@index([teamId])
}

model ServingAssignment {
  id             String                  @id @default(cuid())
  organizationId String
  positionId     String
  personId       String
  status         ServingAssignmentStatus @default(ACTIVE)
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position     ServingPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  person       Person          @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([positionId, personId])
  @@index([organizationId])
  @@index([personId])
}

model PersonQualification {
  id             String    @id @default(cuid())
  organizationId String
  personId       String
  name           String
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  person       Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, name])
  @@index([organizationId])
  @@index([personId])
}

// ---------------------------------------------------------------------------
// Files (BLUEPRINT §41 -- private storage, per-request authorized downloads)
// ---------------------------------------------------------------------------

model File {
  id             String    @id @default(cuid())
  organizationId String
  fileName       String
  contentType    String
  sizeBytes      Int
  storageKey     String    @unique
  relatedPersonId String?
  uploadedByUserId String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  relatedPerson Person?      @relation(fields: [relatedPersonId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([relatedPersonId])
}

// ---------------------------------------------------------------------------
// Developer platform (BLUEPRINT §42/§43)
// ---------------------------------------------------------------------------

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  createdByUserId String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WebhookSubscription {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  organizationId String
  subscriptionId String
  eventId        String
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status, attempts])
}
