# --- Required for local development (no other keys are needed) ---
# Matches docker-compose.yml's postgres service credentials. DIRECT_DATABASE_URL is
# only meaningfully different from DATABASE_URL when the latter is a pooled
# connection (e.g. Neon in production) -- for local Postgres they're the same value.
DATABASE_URL="postgresql://cms:cms@localhost:5432/cms_dev"
DIRECT_DATABASE_URL="postgresql://cms:cms@localhost:5432/cms_dev"

# NextAuth v5 requires a secret for signing session tokens.
# Generate one locally with: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional: only needed to exercise live/real integrations ---
# Shared secret for the outbox cron endpoint (app/api/cron/outbox/route.ts).
# Required in any environment where the durable outbox drain is used -- generate with:
# openssl rand -base64 32
CRON_SECRET=""

# Resend (real email delivery). Leave unset to fall back to ConsoleEmailProvider.
RESEND_API_KEY=""
RESEND_EMAIL_DOMAIN=""

# Private file storage directory for the File primitive. Defaults to .private-storage.
CMS_PRIVATE_STORAGE_DIR=""

# Sentry (error monitoring, free tier). Leave unset to disable -- the SDK is a no-op
# without a DSN, it won't throw. DSNs aren't secret (safe to ship in the client
# bundle), which is why this is NEXT_PUBLIC_ and shared across client/server/edge.
NEXT_PUBLIC_SENTRY_DSN=""
